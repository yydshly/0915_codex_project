+++ b/src/features/dancer/materials/sculpt.ts
@@ -0,0 +1,97 @@
+import { BufferGeometry, CatmullRomCurve3, Euler, Float32BufferAttribute, Matrix4, Quaternion, SphereGeometry, TubeGeometry, Uint16BufferAttribute, Vector3 } from 'three'
+import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js'
+import { mergeGeometries } from 'three/examples/jsm/utils/BufferGeometryUtils.js'
+
+export type Point = [number, number, number]
+export type Palette = 'skin' | 'blush' | 'hair' | 'hairLight' | 'ink' | 'cream' | 'mint' | 'mintDark' | 'pants' | 'gold' | 'iris' | 'white'
+type Weight = number | ((point: Vector3) => [number, number, number])
+export type Sculpt = ReturnType<typeof createSculpt>
+
+export function createSculpt() {
+  const groups = new Map<Palette, BufferGeometry[]>()
+  function add(geometry: BufferGeometry, color: Palette, bone: Weight, position: Point = [0, 0, 0], size: Point = [1, 1, 1], rotation: Point = [0, 0, 0]) {
+    const source = geometry.index ? geometry.toNonIndexed() : geometry.clone()
+    geometry.dispose()
+    source.applyMatrix4(new Matrix4().compose(new Vector3(...position), new Quaternion().setFromEuler(new Euler(...rotation)), new Vector3(...size)))
+    const vertices = source.getAttribute('position')
+    const indices: number[] = [], weights: number[] = []
+    const point = new Vector3()
+    for (let i = 0; i < vertices.count; i++) {
+      point.fromBufferAttribute(vertices, i)
+      const [first, second, blend] = typeof bone === 'number' ? [bone, bone, 0] : bone(point)
+      indices.push(first, second, 0, 0)
+      weights.push(1 - blend, blend, 0, 0)
+    }
+    source.setAttribute('skinIndex', new Uint16BufferAttribute(indices, 4))
+    source.setAttribute('skinWeight', new Float32BufferAttribute(weights, 4))
+    source.deleteAttribute('uv')
+    const parts = groups.get(color) ?? []
+    parts.push(source)
+    groups.set(color, parts)
+  }
+  return {
+    add,
+    oval(color: Palette, bone: Weight, position: Point, size: Point, rotation: Point = [0, 0, 0]) {
+      add(new SphereGeometry(1, 32, 24), color, bone, position, size, rotation)
+    },
+    box(color: Palette, bone: Weight, position: Point, size: Point, rotation: Point = [0, 0, 0], radius = 0.08) {
+      add(new RoundedBoxGeometry(1, 1, 1, 3, radius), color, bone, position, size, rotation)
+    },
+    line(color: Palette, bone: Weight, points: Point[], radius: number) {
+      add(new TubeGeometry(new CatmullRomCurve3(points.map(p => new Vector3(...p))), 24, radius, 8, false), color, bone)
+    },
+    finish() {
+      return [...groups].map(([color, parts]) => {
+        const geometry = mergeGeometries(parts)
+        if (!geometry) throw new Error(`Mika geometry could not merge: ${color}`)
+        for (const part of parts) part.dispose()
+        geometry.computeBoundingSphere()
+        return { color, geometry }
+      })
+    },
+  }
+}
+
+export function ringSurface(rings: [number, number, number, number][], segments = 40) {
+  const positions: number[] = [], indices: number[] = []
+  for (const [y, width, depth, z] of rings) {
+    for (let j = 0; j <= segments; j++) {
+      const angle = j / segments * Math.PI * 2
+      positions.push(width * Math.sin(angle), y, z + depth * Math.cos(angle))
+    }
+  }
+  for (let i = 0; i < rings.length - 1; i++) for (let j = 0; j < segments; j++) {
+    const a = i * (segments + 1) + j, b = a + segments + 1
+    indices.push(a, a + 1, b, b, a + 1, b + 1)
+  }
+  const result = new BufferGeometry()
+  result.setAttribute('position', new Float32BufferAttribute(positions, 3))
+  result.setIndex(indices)
+  result.computeVertexNormals()
+  return result
+}
+
+export function hairLock(points: Point[], width: number, depth: number) {
+  const curve = new CatmullRomCurve3(points.map(p => new Vector3(...p)))
+  const frames = curve.computeFrenetFrames(24, false)
+  const positions: number[] = [], indices: number[] = []
+  for (let i = 0; i <= 24; i++) {
+    const t = i / 24, center = curve.getPoint(t)
+    const taper = Math.max(0.008, Math.pow(Math.sin(Math.PI * (0.09 + 0.91 * t)), 0.65))
+    for (let j = 0; j <= 12; j++) {
+      const angle = j / 12 * Math.PI * 2
+      const p = center.clone().addScaledVector(frames.normals[i], Math.cos(angle) * width * taper)
+        .addScaledVector(frames.binormals[i], Math.sin(angle) * depth * taper)
+      positions.push(p.x, p.y, p.z)
+    }
+  }
+  for (let i = 0; i < 24; i++) for (let j = 0; j < 12; j++) {
+    const a = i * 13 + j, b = a + 13
+    indices.push(a, a + 1, b, a + 1, b + 1, b)
+  }
+  const result = new BufferGeometry()
+  result.setAttribute('position', new Float32BufferAttribute(positions, 3))
+  result.setIndex(indices)
+  result.computeVertexNormals()
+  return result
+}
