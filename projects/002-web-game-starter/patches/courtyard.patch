@@ -0,0 +1,76 @@
+import { Component, Suspense, useEffect, useMemo, useReducer, type ReactNode } from 'react'
+import { DanceStudioScene } from '../../../scenes/dance-studio/DanceStudioScene'
+import { defaultControls, type DanceControls, type CameraView, type Dance } from '../systems/choreography'
+import styles from './DanceStudioScreen.module.css'
+import { MusicTransport, type MusicState } from '../components/MusicTransport'
+import { MusicPanel } from './MusicPanel'
+
+const dances: { id: Dance; number: string; name: string; description: string }[] = [
+  { id: 'groove', number: '01', name: '轻快律动', description: '左右重心 · 踏拍 · 展臂' },
+  { id: 'wave', number: '02', name: '手臂波浪', description: '肩肘传递 · 上身律动' },
+  { id: 'idle', number: '03', name: '静态欣赏', description: '放松站姿 · 观察造型' },
+]
+
+export function DanceStudioScreen() {
+  const [controls, dispatch] = useReducer((state: DanceControls, update: Partial<DanceControls>) => ({ ...state, ...update }), defaultControls)
+  const transport = useMemo(() => new MusicTransport(), [])
+  const [music, setMusic] = useReducer((_: MusicState, value: MusicState) => value, transport.state)
+  useEffect(() => {
+    const unsubscribe = transport.subscribe(state => {
+      setMusic(state)
+      if (state.name) dispatch({ playing: state.playing })
+    })
+    return () => { unsubscribe(); transport.dispose() }
+  }, [transport])
+  function togglePlayback() {
+    if (music.name) { if (music.playing) transport.pause(); else void transport.play() }
+    else dispatch({ playing: !controls.playing })
+  }
+  useEffect(() => { document.title = 'MIKA · 原创人物与舞蹈' }, [])
+  const selected = dances.find(dance => dance.id === controls.dance)!
+  const sample = import.meta.env.DEV ? new URLSearchParams(window.location.search).get('pose') : null
+  const sampleTime = sample !== null && Number.isFinite(Number(sample)) ? Number(sample) : undefined
+  return <main className={styles.page}>
+    <header className={styles.header}>
+      <a href="/courtyard" className={styles.brand}><span className={styles.monogram}>m.</span><span>MOTION ATELIER<small>角色与动作工坊</small></span></a>
+      <span className={styles.headerNote}>CHARACTER STUDY <b>001</b></span>
+    </header>
+    <div className={styles.layout}>
+      <section className={styles.stage} aria-label="Mika 三维人物展示">
+        <div className={styles.stageLabel}><span className={styles.dot} /> ORIGINAL CHARACTER <span>/ 2026</span></div>
+        <div className={styles.watermark} aria-hidden="true">MIKA</div>
+        <div className={styles.canvas}><StudioErrorBoundary><Suspense fallback={<div className={styles.loading}>正在准备 Mika…</div>}>
+          <DanceStudioScene controls={controls} sampleTime={sampleTime} musicClock={transport} />
+        </Suspense></StudioErrorBoundary></div>
+        <div className={styles.viewControls} aria-label="观察视角">{([['front', '正面'], ['side', '侧面'], ['back', '背面'], ['detail', '细节']] as [CameraView, string][]).map(([view, label]) =>
+          <button key={view} aria-pressed={controls.view === view} onClick={() => dispatch({ view, revision: controls.revision + 1 })}>{label}</button>)}</div>
+        <div className={styles.stageBottom}><span><b>MIKA</b> / 薄荷律动</span><span>拖动旋转 · 滚轮缩放</span></div>
+      </section>
+      <aside className={styles.panel}>
+        <div className={styles.intro}><p className={styles.eyebrow}>MEET YOUR DANCER</p><h1>嗨，我是 Mika<span>让每一拍，都有表情。</span></h1>
+          <p className={styles.description}>薄荷绿夹克、深蓝短发，一点俏皮，<br />还有随时起舞的好心情。</p>
+          <div className={styles.tags}><span>原创人物</span><span>原创编舞</span><span>本地运行</span></div>
+        </div>
+        <div className={styles.motionHeader}><h2>选一支舞</h2><span>{music.name ? music.bpm : 108} BPM</span></div>
+        <div className={styles.dances}>{dances.map(dance => <button key={dance.id} className={styles.dance} aria-pressed={controls.dance === dance.id}
+          onClick={() => dispatch({ dance: dance.id, playing: music.name ? music.playing : true })}><span className={styles.danceNumber}>{dance.number}</span><span><strong>{dance.name}</strong><small>{dance.description}</small></span><span className={styles.selected}>{controls.dance === dance.id ? '●' : '↗'}</span></button>)}</div>
+        <div className={styles.playback}><button className={styles.play} onClick={togglePlayback} aria-label={controls.playing ? '暂停舞蹈' : '播放舞蹈'}><span>{controls.playing ? 'Ⅱ' : '▷'}</span>{controls.playing ? '暂停' : '播放'}</button>
+          <div className={styles.nowPlaying}><small>{controls.playing ? '正在播放' : '已暂停'}</small><strong>{selected.name}</strong></div>
+          <div className={`${styles.equalizer} ${controls.playing ? styles.moving : ''}`} aria-hidden="true"><i /><i /><i /><i /></div>
+        </div>
+        <label className={styles.speed}>播放速度 <output>{controls.speed.toFixed(2)}×</output><input aria-label="播放速度" type="range" min="0.5" max="1.5" step="0.25" value={controls.speed} onChange={event => { const speed = Number(event.target.value); transport.setSpeed(speed); dispatch({ speed }) }} /></label>
+        <MusicPanel transport={transport} state={music} onImport={() => dispatch({ playing: false })} onToggle={togglePlayback} />
+        <div className={styles.note}><span>一点制作细节</span><p>从曲面造型、骨骼蒙皮，到每一拍的关节姿势，均由本地代码制作。切换到「细节」，近距离看看她。</p></div>
+      </aside>
+    </div>
+    <footer className={styles.footer}><span>CHARACTER → MOTION → MUSIC</span><span>原创人物与编舞 · 导入音乐同步播放</span></footer>
+  </main>
+}
+
+class StudioErrorBoundary extends Component<{ children: ReactNode }, { failed: boolean }> {
+  state = { failed: false }
+  static getDerivedStateFromError() { return { failed: true } }
+  render() {
+    return this.state.failed ? <div className={styles.loading}>人物加载遇到问题。<button onClick={() => window.location.reload()}>重新加载</button></div> : this.props.children
+  }
+}
