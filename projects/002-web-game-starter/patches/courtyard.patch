+import { useFrame } from '@react-three/fiber'
+import { useEffect, useRef } from 'react'
+import { Group, Vector3 } from 'three'
+import { Tany } from '../../features/character/entities/Tany/Tany'
+import { courtyardResources as resources } from '../../features/courtyard/materials/courtyardResources'
+import { inspectionPath, stations, type InspectionState } from '../../features/courtyard/systems/inspection'
+
+type GuideProps = { state: InspectionState; onArrival: (trip: number) => void }
+
+export function InspectionGuide({ state, onArrival }: GuideProps) {
+  const root = useRef<Group>(null)
+  const path = useRef<Vector3[]>([])
+  const activeTrip = useRef(state.trip)
+  const nextDirection = useRef(new Vector3())
+  const finished = useRef(true)
+  useEffect(() => {
+    if (!root.current || !state.moving) return
+    const destination = stations.find((station) => station.id === state.selected)!.location
+    path.current = inspectionPath(root.current.position.toArray(), destination).map((point) => new Vector3(...point))
+    activeTrip.current = state.trip
+    finished.current = false
+  }, [state.trip, state.moving, state.selected])
+  useFrame((_, delta) => {
+    if (!root.current || finished.current) return
+    const target = path.current[0]
+    if (!target) {
+      finished.current = true
+      onArrival(activeTrip.current)
+      root.current.rotation.y = 0.35
+      return
+    }
+    const direction = nextDirection.current.subVectors(target, root.current.position)
+    const step = Math.min(delta, 0.05) * 4.5
+    if (direction.length() <= step) {
+      root.current.position.copy(target)
+      path.current.shift()
+    } else {
+      root.current.position.addScaledVector(direction.normalize(), step)
+      root.current.rotation.y = Math.atan2(direction.x, direction.z)
+    }
+  })
+  return <group ref={root} position={[0, 0.23, 6.5]} dispose={null}>
+    <mesh geometry={resources.disc} material={resources.dark} castShadow />
+    <mesh geometry={resources.ring} material={resources.glow} rotation-x={Math.PI / 2} />
+    <Tany position={[0, 0.055, 0]} animation={state.celebrating ? 'dance' : 'idle'} />
+  </group>
+}
