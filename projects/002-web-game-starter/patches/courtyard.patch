+import { CourtyardScene } from '../../../scenes/courtyard/CourtyardScene'
+import { Component, Suspense, useEffect, useReducer, type ReactNode } from 'react'
+import { initialInspection, inspectionReducer, stations } from '../systems/inspection'
+import styles from './CourtyardScreen.module.css'
+
+export function CourtyardScreen() {
+  const [state, dispatch] = useReducer(inspectionReducer, initialInspection)
+  useEffect(() => { document.title = '青屿庭院 · 3D 交互巡检' }, [])
+  const current = stations.find((station) => station.id === state.selected)!
+  const completed = Object.values(state.checked).filter(Boolean).length
+  const ready = state.arrived === state.selected && !state.moving
+  const operating = state.selected === 'water' ? state.water : state.selected === 'energy' ? state.lights : state.falling
+  const actionLabel = !ready ? (state.moving ? '向导前往中…' : `前往${current.title} →`)
+    : state.selected === 'water' ? (state.water ? '关闭循环水泵' : '启动循环水泵')
+      : state.selected === 'energy' ? (state.lights ? '关闭庭院照明' : '开启照明 · 切换夜景')
+        : state.falling ? '测试箱下落中…' : state.drop ? '重新释放测试箱' : '释放测试箱'
+  const status = !ready ? (state.moving ? '向导正在沿步道前往设施' : '选择设施，开始一次巡检')
+    : state.selected === 'physics' ? (state.falling ? '等待测试箱碰撞' : state.checked.physics ? '已检测到落地碰撞' : '测试台就绪')
+      : operating ? '设备运行中' : '设备待机中'
+  return <main className={`${styles.screen} ${state.night ? styles.night : ''}`}>
+    <header className={styles.header}>
+      <div className={styles.brand}><div className={styles.logo}>青</div><div><h1>青屿庭院</h1><span className={styles.eyebrow}>QINGYU / INTERACTIVE COURTYARD</span></div></div>
+      <div className={styles.topActions}>
+        <button className={styles.button} aria-pressed={state.night} onClick={() => dispatch({ type: 'night' })}>{state.night ? '☾ 夜间' : '☀ 日间'}</button>
+        <button className={styles.button} onClick={() => dispatch({ type: 'camera' })}>复位视角</button>
+        <button className={styles.button} onClick={() => dispatch({ type: 'reset' })}>重新巡检</button>
+      </div>
+    </header>
+    <div className={styles.layout}>
+      <section className={styles.viewport} aria-label="可旋转的三维庭院">
+        <div className={styles.scene}>
+          <SceneErrorBoundary><Suspense fallback={<div className={styles.loading}>正在准备庭院模型与物理引擎…</div>}>
+            <CourtyardScene state={state} dispatch={dispatch} />
+          </Suspense></SceneErrorBoundary>
+        </div>
+        <div className={styles.sceneHeading}><p>一座庭院 · 三次交互</p><h2>让空间，回应你的操作。</h2><span>点击场景标记，跟随虚拟向导探索设施。</span></div>
+        <div className={styles.hint}>拖动旋转视角 · 滚轮缩放 · 点击标记前往</div>
+      </section>
+      <aside className={styles.panel} aria-label="巡检任务面板">
+        <p className={styles.sectionLabel}>TODAY'S WALKTHROUGH</p>
+        <div className={styles.progressTitle}><h2>庭院巡检</h2><strong>{completed}<small> / 3</small></strong></div>
+        <div className={styles.progress} aria-label={`已完成 ${completed} 项，共 3 项`}>{stations.map((station) => <i key={station.id} data-done={state.checked[station.id]} />)}</div>
+        <nav className={styles.stations} aria-label="选择巡检设施">{stations.map((station) => <button
+          key={station.id} className={styles.station} aria-pressed={state.selected === station.id}
+          onClick={() => dispatch({ type: 'select', id: station.id })}>
+          <span className={styles.stationNumber}>{state.checked[station.id] ? '✓' : station.number}</span>
+          <span><strong>{station.title}</strong><small>{station.subtitle}</small></span>
+        </button>)}</nav>
+        <section className={styles.detail}>
+          <h3>{current.title}</h3><p className={styles.description}>{current.description}</p>
+          <div className={styles.status} role="status">{status}</div>
+          <button className={styles.primary} disabled={state.moving || (state.selected === 'physics' && state.falling)}
+            onClick={() => dispatch(ready ? { type: 'operate' } : { type: 'select', id: state.selected })}>{actionLabel}</button>
+          <div className={styles.capability}><b>这一站用到的能力</b>{current.capability}</div>
+        </section>
+        {completed === 3 ? <section className={styles.complete} aria-label="巡检完成"><strong>✓ 本次巡检已完成</strong>
+          <p>水循环、庭院照明和落地碰撞均已体验。继续旋转场景，或让向导庆祝一下。</p>
+          <button className={styles.button} disabled={state.moving} onClick={() => dispatch({ type: 'celebrate' })}>{state.celebrating ? '停止庆祝' : '向导庆祝 ✧'}</button>
+        </section> : null}
+      </aside>
+    </div>
+    <footer className={styles.footer}><span>WEB STARTER KIT / 应用场景 01</span><span>交互模拟演示 · 未连接真实设备或传感器</span></footer>
+  </main>
+}
+
+class SceneErrorBoundary extends Component<{ children: ReactNode }, { failed: boolean }> {
+  state = { failed: false }
+  static getDerivedStateFromError() { return { failed: true } }
+  render() {
+    return this.state.failed ? <div className={styles.error}><strong>场景暂时未能加载</strong><span>请重新载入，恢复模型和图形上下文。</span>
+      <button className={styles.button} onClick={() => window.location.reload()}>重新载入</button></div> : this.props.children
+  }
+}
