+import { MeshStandardMaterial } from 'three'
+import { ShaderWarmupRegistry } from '@vibegameengine/shader-warmup'
+import { createSculpt, type Palette } from './sculpt'
+import { sculptFace } from './mikaFace'
+import { sculptOutfit } from './mikaOutfit'
+
+const tones: Record<Palette, string> = {
+  skin: '#eeb99a', blush: '#cf777a', hair: '#17243c', hairLight: '#2d4563',
+  ink: '#161c30', cream: '#fff0d7', mint: '#76d2b7', mintDark: '#318b7e',
+  pants: '#35394e', gold: '#eeb96a', iris: '#599caa', white: '#ffffff',
+}
+export const mikaMaterials = Object.fromEntries(Object.entries(tones).map(([name, color]) => [name,
+  new MeshStandardMaterial({ color, roughness: name === 'gold' ? 0.3 : name === 'hair' || name === 'hairLight' ? 0.42 : 0.72, metalness: name === 'gold' ? 0.55 : 0 }),
+])) as Record<Palette, MeshStandardMaterial>
+const sculpt = createSculpt()
+sculptOutfit(sculpt)
+sculptFace(sculpt)
+export const mikaSurfaces = sculpt.finish()
+for (const { color, geometry } of mikaSurfaces) ShaderWarmupRegistry.register(`mika-${color}`, geometry, mikaMaterials[color])
