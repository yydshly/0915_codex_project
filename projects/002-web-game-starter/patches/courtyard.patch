+++ b/scripts/generate-mika-music.py
@@ -0,0 +1,55 @@
+"""Generate one backing track locally. Never expose the API key to Vite."""
+import argparse
+import json
+from pathlib import Path
+import urllib.request
+import urllib.error
+from urllib.parse import urlsplit
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--env-file', required=True)
+parser.add_argument('--model', default='music-3.0')
+args = parser.parse_args()
+folder = Path(__file__).resolve().parents[1] / 'public' / 'music'
+target = folder / 'mika-minimax.mp3'
+if target.exists():
+    raise SystemExit('Output already exists; refusing to generate a duplicate.')
+config = {}
+for line in Path(args.env_file).read_text(encoding='utf-8-sig').splitlines():
+    if '=' in line and not line.lstrip().startswith('#'):
+        key, value = line.split('=', 1)
+        config[key.strip()] = value.strip().strip('\"').strip("'")
+base = config.get('MINIMAX_API_BASE', 'https://api.minimax.cn').rstrip('/')
+parts = urlsplit(base)
+if parts.scheme != 'https' or parts.hostname not in {'api.minimax.cn', 'api.minimax.io', 'api.minimaxi.com'} or parts.query or parts.username:
+    raise SystemExit('Unsupported API origin; use an official MiniMax HTTPS endpoint.')
+url = base.removesuffix('/v1') + '/v1/music_generation'
+prompt = '轻快的 funk-pop 纯音乐，108 BPM，4/4 拍。清晰有力的底鼓和军鼓、弹性贝斯、切分节奏吉他、明亮而克制的合成器。适合俏皮卡通女孩跳街舞。开头尽快进入稳定节拍，每 8 拍形成一个短句，避免长前奏、变速和突然停顿。约 45 秒，无人声，无歌词。'
+payload = {'model': args.model, 'prompt': prompt, 'is_instrumental': True, 'stream': False, 'output_format': 'hex', 'audio_setting': {'sample_rate': 44100, 'bitrate': 256000, 'format': 'mp3'}}
+request = urllib.request.Request(url, json.dumps(payload).encode(), {'Authorization': 'Bearer ' + config['MINIMAX_API_KEY'], 'Content-Type': 'application/json'})
+try:
+    with urllib.request.urlopen(request, timeout=300) as response:
+        result = json.load(response)
+except urllib.error.HTTPError as error:
+    print('MiniMax HTTP status:', error.code)
+    try:
+        result = json.load(error)
+    except (ValueError, OSError):
+        raise SystemExit('Request failed without a readable API status.') from None
+except (urllib.error.URLError, TimeoutError):
+    raise SystemExit('Network request did not complete. No automatic retry was made.') from None
+status = result.get('base_resp', {})
+if status.get('status_code') != 0:
+    print('MiniMax API status:', status.get('status_code'))
+    message = str(status.get('status_msg', 'Unknown error')).replace(config['MINIMAX_API_KEY'], '[redacted]')
+    raise SystemExit(message[:300])
+audio = bytes.fromhex(result['data']['audio'])
+if len(audio) < 1000:
+    raise SystemExit('No usable audio returned.')
+folder.mkdir(parents=True, exist_ok=True)
+if target.exists():
+    raise SystemExit('Output already exists; refusing to overwrite.')
+target.write_bytes(audio)
+metadata = {'provider': 'MiniMax', 'model': args.model, 'prompt': prompt, 'requestedBpm': 108, 'extraInfo': result.get('extra_info', {})}
+(folder / 'mika-minimax.json').write_text(json.dumps(metadata, ensure_ascii=False, indent=2), encoding='utf-8')
+print(json.dumps({'file': str(target), 'bytes': len(audio), 'extraInfo': metadata['extraInfo']}, ensure_ascii=False))
