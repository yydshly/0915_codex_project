diff --git a/src/scenes/courtyard/CourtyardScene.tsx b/src/scenes/courtyard/CourtyardScene.tsx
new file mode 100644
index 0000000..129a068
--- /dev/null
+++ b/src/scenes/courtyard/CourtyardScene.tsx
@@ -0,0 +1,75 @@
+import { Html, OrbitControls } from '@react-three/drei'
+import { Canvas, useThree } from '@react-three/fiber'
+import { Bloom, EffectComposer, N8AO, SMAA, ToneMapping } from '@react-three/postprocessing'
+import { ShaderWarmup } from '@vibegameengine/shader-warmup'
+import { ToneMappingMode } from 'postprocessing'
+import { PCFShadowMap, PerspectiveCamera, type Camera } from 'three'
+import { useCallback, useEffect, useRef, type Dispatch } from 'react'
+import type { OrbitControls as OrbitControlsImpl } from 'three-stdlib'
+
+import { useReportInitialRenderReady } from '../../features/bootstrap'
+import { CourtyardArchitecture } from '../../features/courtyard/entities/CourtyardArchitecture'
+import { CirculationFlow, CourtyardLights, EquipmentDrop } from '../../features/courtyard/entities/CourtyardEquipment'
+import { stations, type InspectionAction, type InspectionState } from '../../features/courtyard/systems/inspection'
+import { DanceFireworks } from '../../features/world/entities/DanceFireworks'
+import { Water } from '../../features/world/entities/Water'
+import { ShadowGroup } from '../../shared/lib/ShadowGroup'
+import { SunShadow } from '../../shared/lib/SunShadow'
+import { ShadowCompositor } from '../../shared/lib/shadows'
+import { InspectionGuide } from './InspectionGuide'
+import styles from '../../features/courtyard/ui/CourtyardScreen.module.css'
+
+type SceneProps = { state: InspectionState; dispatch: Dispatch<InspectionAction> }
+
+export function CourtyardScene({ state, dispatch }: SceneProps) {
+  useReportInitialRenderReady()
+  const onArrival = useCallback((trip: number) => dispatch({ type: 'arrive', trip }), [dispatch])
+  const background = state.night ? '#203c45' : '#c4d4ca'
+  return <Canvas shadows={{ type: PCFShadowMap }} dpr={1} maxFps={60}
+    camera={{ fov: 40, near: 0.1, far: 150, position: [19, 19, 25] }}
+    gl={{ antialias: false, powerPreference: 'high-performance' }}>
+    <color attach="background" args={[background]} />
+    <fog attach="fog" args={[background, 55, 105]} />
+    <hemisphereLight args={[state.night ? '#8fc8e7' : '#deeeef', '#928b67', state.night ? 0.45 : 1.25]} />
+    <SunShadow color={state.night ? '#a4cce5' : '#ffe7bf'} intensity={state.night ? 0.45 : 2.5} offset={[12, 22, 8]} radius={17} resolution={2048} />
+    <ShadowCompositor every={2} />
+    <ShaderWarmup />
+    <ShadowGroup kind="static"><CourtyardArchitecture /></ShadowGroup>
+    <Water level={0.28} size={[6.1, 4.9]} position={[-4.8, -2.2]} />
+    <CourtyardLights on={state.lights} />
+    <CirculationFlow active={state.water} />
+    <ShadowGroup kind="dynamic">
+      <InspectionGuide key={state.generation} state={state} onArrival={onArrival} />
+      <EquipmentDrop key={`equipment-${state.generation}`} drop={state.drop}
+        onLand={() => dispatch({ type: 'land', drop: state.drop, generation: state.generation })} />
+    </ShadowGroup>
+    <DanceFireworks active={state.celebrating} />
+    {stations.map((station) => <Html key={station.id} position={station.marker} center zIndexRange={[20, 0]}>
+      <button className={styles.marker} aria-label={`前往${station.title}`} aria-pressed={state.selected === station.id}
+        onClick={() => dispatch({ type: 'select', id: station.id })}>
+        <b>{state.checked[station.id] ? '✓' : station.number}</b>{station.title}
+      </button>
+    </Html>)}
+    <InspectionCamera revision={state.camera} />
+    <EffectComposer multisampling={0}>
+      <N8AO halfRes aoRadius={0.8} intensity={1.5} />
+      <Bloom intensity={0.3} luminanceThreshold={1} mipmapBlur />
+      <SMAA /><ToneMapping mode={ToneMappingMode.ACES_FILMIC} />
+    </EffectComposer>
+  </Canvas>
+}
+
+function InspectionCamera({ revision }: { revision: number }) {
+  const controls = useRef<OrbitControlsImpl>(null)
+  const { camera, size } = useThree()
+  useEffect(() => { controls.current?.reset() }, [revision])
+  useEffect(() => { fitCameraToViewport(camera, size.width / size.height) }, [camera, size.width, size.height, revision])
+  return <OrbitControls ref={controls} makeDefault target={[0, 0, 0]} minDistance={17} maxDistance={55} maxPolarAngle={1.3} enablePan={false} />
+}
+
+function fitCameraToViewport(camera: Camera, aspect: number) {
+  if (camera instanceof PerspectiveCamera) {
+    camera.zoom = Math.min(1, aspect / 1.15)
+    camera.updateProjectionMatrix()
+  }
+}
