@@ -0,0 +1,53 @@
+import { Bone, Group, Skeleton, SkinnedMesh } from 'three'
+import { mikaSurfaces, mikaMaterials } from '../materials/mikaResources'
+
+export const joint = {
+  hips: 0, spine: 1, chest: 2, neck: 3, head: 4,
+  leftArm: 5, leftForearm: 6, leftHand: 7,
+  rightArm: 8, rightForearm: 9, rightHand: 10,
+  leftThigh: 11, leftShin: 12, leftFoot: 13,
+  rightThigh: 14, rightShin: 15, rightFoot: 16,
+} as const
+
+export function createMikaRig() {
+  const root = new Group()
+  root.name = 'Mika'
+  const bones: Bone[] = []
+  function add(name: keyof typeof joint, parent: number | null, x: number, y: number, z = 0) {
+    const bone = new Bone()
+    bone.name = name
+    bone.position.set(x, y, z)
+    if (parent === null) root.add(bone)
+    else bones[parent].add(bone)
+    bones.push(bone)
+  }
+  add('hips', null, 0, 1.1)
+  add('spine', 0, 0, 0.2)
+  add('chest', 1, 0, 0.3)
+  add('neck', 2, 0, 0.2)
+  add('head', 3, 0, 0.3)
+  add('leftArm', 2, 0.34, 0.04)
+  add('leftForearm', 5, 0, -0.34)
+  add('leftHand', 6, 0, -0.30)
+  add('rightArm', 2, -0.34, 0.04)
+  add('rightForearm', 8, 0, -0.34)
+  add('rightHand', 9, 0, -0.30)
+  add('leftThigh', 0, 0.17, 0)
+  add('leftShin', 11, 0, -0.50)
+  add('leftFoot', 12, 0, -0.46)
+  add('rightThigh', 0, -0.17, 0)
+  add('rightShin', 14, 0, -0.50)
+  add('rightFoot', 15, 0, -0.46)
+  root.updateMatrixWorld(true)
+  const skeleton = new Skeleton(bones)
+  for (const { color, geometry } of mikaSurfaces) {
+    const mesh = new SkinnedMesh(geometry, mikaMaterials[color])
+    mesh.name = `Mika_${color}`
+    mesh.castShadow = true
+    mesh.receiveShadow = false
+    mesh.frustumCulled = false
+    root.add(mesh)
+    mesh.bind(skeleton)
+  }
+  return { root, bones, skeleton }
+}
