+import { Instance, Instances } from '@react-three/drei'
+import { useFrame } from '@react-three/fiber'
+import { CuboidCollider, Physics, RigidBody } from '@react-three/rapier'
+import { useRef } from 'react'
+import { Group } from 'three'
+import { courtyardResources as resources } from '../materials/courtyardResources'
+
+const lamps: [number, number, number][] = [[-1, 1.1, 5.7], [1, 1.1, 3.5], [-8.7, 1.1, 1.4], [8.6, 1.1, 1.4], [2.1, 2.75, -2], [7.1, 2.75, -2]]
+
+export function CourtyardLights({ on }: { on: boolean }) {
+  return <group dispose={null}>
+    <Instances geometry={resources.lamp} material={on ? resources.lampOn : resources.lampOff}>
+      {lamps.map((point) => <Instance key={point.join(',')} position={point} />)}
+    </Instances>
+    <Instances geometry={resources.box} material={resources.dark} castShadow>
+      {lamps.slice(0, 4).map(([x, , z]) => <Instance key={`${x}-${z}`} position={[x, 0.5, z]} scale={[0.1, 1.05, 0.1]} />)}
+    </Instances>
+    <pointLight position={[0, 1.7, 4.6]} color="#ffd196" intensity={on ? 13 : 0} distance={8} decay={2} />
+    <pointLight position={[4.6, 2.5, -3.2]} color="#ffe3a8" intensity={on ? 24 : 0} distance={9} decay={2} />
+    <pointLight position={[-7, 1.8, 1]} color="#87ffdc" intensity={on ? 9 : 0} distance={7} decay={2} />
+  </group>
+}
+
+export function CirculationFlow({ active }: { active: boolean }) {
+  const stream = useRef<Group>(null)
+  useFrame(({ clock }) => {
+    if (!stream.current) return
+    const pulse = 0.94 + Math.sin(clock.elapsedTime * 4) * 0.06
+    stream.current.scale.x = pulse
+  })
+  return <group visible={active} dispose={null}>
+    <group ref={stream} position={[-4.8, 0, -3.36]}>
+      <mesh geometry={resources.box} material={resources.glow} position={[0, 0.85, 0]} scale={[0.85, 1, 0.055]} />
+    </group>
+    <mesh geometry={resources.ring} material={resources.glow} position={[-4.8, 0.31, -3.25]} rotation-x={Math.PI / 2} />
+  </group>
+}
+
+type DropProps = { drop: number; onLand: () => void }
+
+export function EquipmentDrop({ drop, onLand }: DropProps) {
+  const reported = useRef(0)
+  return <Physics gravity={[0, -9.81, 0]} timeStep={1 / 60}>
+    <RigidBody type="fixed" colliders={false}>
+      <CuboidCollider args={[1.925, 0.05, 1.425]} position={[5.8, 0.53, 4.3]} />
+      <CuboidCollider args={[11, 0.1, 8.5]} position={[0, -0.12, 0]} />
+    </RigidBody>
+    {drop > 0 ? <RigidBody key={drop} position={[5.8, 2.5, 4.3]} rotation={[0.12, 0.25, 0.18]}
+      colliders={false} restitution={0.4} friction={0.75} angularVelocity={[0.35, 0.15, 0.25]}
+      onCollisionEnter={() => { if (reported.current !== drop) { reported.current = drop; onLand() } }}>
+      <CuboidCollider args={[0.43, 0.43, 0.43]} />
+      <group dispose={null}>
+        <mesh geometry={resources.box} material={resources.crate} scale={[0.86, 0.86, 0.86]} castShadow />
+        <mesh geometry={resources.box} material={resources.dark} scale={[0.12, 0.89, 0.89]} />
+        <mesh geometry={resources.box} material={resources.dark} scale={[0.89, 0.12, 0.89]} />
+      </group>
+    </RigidBody> : null}
+  </Physics>
+}
