@@ -0,0 +1,97 @@
+import type { MusicClock } from '../systems/musicTiming'
+
+export type MusicState = { name: string; playing: boolean; loading: boolean; time: number; duration: number; bpm: number; offset: number; volume: number; error: string }
+const empty: MusicState = { name: '', playing: false, loading: false, time: 0, duration: 0, bpm: 108, offset: 0, volume: 0.55, error: '' }
+
+export class MusicTransport implements MusicClock {
+  private audio: HTMLAudioElement | null = null
+  private url: string | null = null
+  private speed = 1
+  private listeners = new Set<(state: MusicState) => void>()
+  state = { ...empty }
+
+  subscribe(listener: (state: MusicState) => void) {
+    this.listeners.add(listener)
+    listener(this.state)
+    return () => { this.listeners.delete(listener) }
+  }
+  private update(change: Partial<MusicState>) {
+    this.state = { ...this.state, ...change }
+    for (const listener of this.listeners) listener(this.state)
+  }
+  load(file: File) {
+    if (file.size > 50 * 1024 * 1024 || file.size === 0 || !(/\.(mp3|wav|ogg|m4a|aac|flac)$/i.test(file.name))) {
+      this.update({ error: '请选择 50 MB 以内的 MP3、WAV、OGG、M4A、AAC 或 FLAC 音频。' })
+      return false
+    }
+    this.release()
+    const url = URL.createObjectURL(file)
+    const audio = new Audio(url)
+    this.audio = audio
+    this.url = url
+    audio.volume = this.state.volume
+    audio.playbackRate = this.speed
+    audio.preload = 'auto'
+    this.update({ name: file.name, playing: false, loading: true, duration: 0, time: 0, offset: 0, error: '' })
+    audio.onloadedmetadata = () => {
+      if (audio !== this.audio) return
+      if (!Number.isFinite(audio.duration) || audio.duration <= 0) this.update({ loading: false, error: '无法读取这段音频的时长，请换一个文件。' })
+      else this.update({ duration: audio.duration, loading: false })
+    }
+    audio.ontimeupdate = () => { if (audio === this.audio) this.update({ time: audio.currentTime }) }
+    audio.onplay = () => { if (audio === this.audio) this.update({ playing: true, error: '' }) }
+    audio.onpause = () => { if (audio === this.audio) this.update({ playing: false }) }
+    audio.onended = () => { if (audio === this.audio) this.update({ playing: false, time: audio.duration }) }
+    audio.onerror = () => { if (audio === this.audio) this.update({ loading: false, playing: false, error: '浏览器无法播放这个音频，请重新导入 MP3 或 WAV 文件。' }) }
+    return true
+  }
+  async play() {
+    const audio = this.audio
+    if (!audio || !this.state.duration || this.state.loading) return false
+    if (audio.ended) audio.currentTime = 0
+    try {
+      await audio.play()
+      return audio === this.audio
+    } catch {
+      if (audio === this.audio) this.update({ playing: false, error: '播放未能启动，请再次点击播放，或重新导入音频。' })
+      return false
+    }
+  }
+  pause() { this.audio?.pause() }
+  seek(time: number) {
+    if (!this.audio || !this.state.duration || !Number.isFinite(time)) return
+    this.audio.currentTime = Math.max(0, Math.min(this.state.duration, time))
+    this.update({ time: this.audio.currentTime })
+  }
+  setSpeed(speed: number) {
+    if (!Number.isFinite(speed)) return
+    this.speed = Math.max(0.5, Math.min(1.5, speed))
+    if (this.audio) this.audio.playbackRate = this.speed
+  }
+  configure(change: Partial<Pick<MusicState, 'bpm' | 'offset' | 'volume'>>) {
+    const bpm = Math.max(40, Math.min(220, change.bpm ?? this.state.bpm))
+    const offset = Math.max(0, Math.min(this.state.duration, change.offset ?? this.state.offset))
+    const volume = Math.max(0, Math.min(1, change.volume ?? this.state.volume))
+    if (![bpm, offset, volume].every(Number.isFinite)) return
+    if (this.audio) this.audio.volume = volume
+    this.update({ bpm, offset, volume })
+  }
+  read() {
+    if (!this.audio || !this.state.duration) return null
+    return { time: this.audio.currentTime, bpm: this.state.bpm, offset: this.state.offset }
+  }
+  clear() { this.release(); this.update({ ...empty, bpm: this.state.bpm, volume: this.state.volume }) }
+  private release() {
+    const audio = this.audio
+    this.audio = null
+    if (audio) {
+      audio.onplay = audio.onpause = audio.onended = audio.ontimeupdate = audio.onerror = audio.onloadedmetadata = null
+      audio.pause()
+      audio.removeAttribute('src')
+      audio.load()
+    }
+    if (this.url) URL.revokeObjectURL(this.url)
+    this.url = null
+  }
+  dispose() { this.release(); this.listeners.clear() }
+}
