+import { OrbitControls } from '@react-three/drei'
+import { Canvas, useThree } from '@react-three/fiber'
+import { ShaderWarmup } from '@vibegameengine/shader-warmup'
+import { useEffect, useRef } from 'react'
+import { ACESFilmicToneMapping, PCFShadowMap, PerspectiveCamera, type Camera } from 'three'
+import type { OrbitControls as OrbitControlsImpl } from 'three-stdlib'
+import { Mika } from '../../features/dancer/entities/Mika'
+import { studioResources as resources } from '../../features/dancer/materials/studioResources'
+import { useReportInitialRenderReady } from '../../features/bootstrap'
+import type { DanceControls } from '../../features/dancer/systems/choreography'
+import type { MusicClock } from '../../features/dancer/systems/musicTiming'
+import { ShadowGroup } from '../../shared/lib/ShadowGroup'
+import { ShadowThrottle } from '../../shared/lib/ShadowThrottle'
+
+export function DanceStudioScene({ controls, sampleTime, musicClock }: { controls: DanceControls; sampleTime?: number; musicClock?: MusicClock }) {
+  useReportInitialRenderReady()
+  return <Canvas shadows={{ type: PCFShadowMap }} dpr={[1, 1.5]} maxFps={60}
+    camera={{ position: [0.4, 1.85, 6.1], fov: 32, near: 0.1, far: 100 }}
+    gl={{ antialias: true, toneMapping: ACESFilmicToneMapping, toneMappingExposure: 1 }}>
+    <color attach="background" args={['#e5e6de']} />
+    <fog attach="fog" args={['#e5e6de', 15, 35]} />
+    <hemisphereLight args={['#fff5e6', '#84968a', 1.4]} />
+    <directionalLight position={[-3, 6, 5]} intensity={2.2} color="#fff0d8" castShadow
+      shadow-mapSize={[2048, 2048]} shadow-camera-left={-4} shadow-camera-right={4} shadow-camera-top={5} shadow-camera-bottom={-3}
+      shadow-normalBias={0.025} shadow-bias={-0.0001} />
+    <directionalLight position={[4, 3, 1]} intensity={0.85} color="#c9eaff" />
+    <directionalLight position={[1, 4, -4]} intensity={1.8} color="#fff6d8" />
+    <ShadowGroup kind="static">
+      <mesh geometry={resources.floor.geometry} material={resources.floor.material} rotation-x={-Math.PI / 2} position-y={-0.125} receiveShadow />
+      <mesh geometry={resources.podium.geometry} material={resources.podium.material} position-y={-0.062} receiveShadow />
+      <mesh geometry={resources.rim.geometry} material={resources.rim.material} rotation-x={Math.PI / 2} position-y={-0.005} />
+    </ShadowGroup>
+    <ShadowGroup kind="dynamic"><Mika dance={controls.dance} playing={controls.playing} speed={controls.speed} sampleTime={sampleTime} musicClock={musicClock} /></ShadowGroup>
+    <StudioCamera controls={controls} />
+    <ShadowThrottle every={2} />
+    <ShaderWarmup />
+  </Canvas>
+}
+
+function StudioCamera({ controls }: { controls: DanceControls }) {
+  const orbit = useRef<OrbitControlsImpl>(null)
+  const { camera, size } = useThree()
+  useEffect(() => {
+    const target = orbit.current
+    if (!target) return
+    const close = controls.view === 'detail'
+    const views = { front: [0.4, 1.85, 6.1], side: [6.1, 1.8, 0.1], back: [0, 1.8, -6.1], detail: [0.15, 2.17, 2.25] } as const
+    const position = views[controls.view]
+    camera.position.set(position[0], position[1], position[2])
+    target.target.set(0, close ? 2.16 : 1.34, 0)
+    target.minDistance = close ? 1.3 : 3.2
+    fitStudioCamera(camera, close, size.width / size.height)
+    target.update()
+  }, [camera, size.width, size.height, controls.view, controls.revision])
+  return <OrbitControls ref={orbit} makeDefault target={[0, 1.34, 0]} minDistance={3.2} maxDistance={9} minPolarAngle={0.5} maxPolarAngle={1.7} enablePan={false} />
+}
+
+function fitStudioCamera(camera: Camera, close: boolean, aspect: number) {
+  if (camera instanceof PerspectiveCamera) {
+    camera.zoom = close ? 1 : Math.min(1, aspect / 0.82)
+    camera.updateProjectionMatrix()
+  }
+}
