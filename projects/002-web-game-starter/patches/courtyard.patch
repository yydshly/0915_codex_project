+.note { border-top: 1px solid #e0e5dc; padding-top: 17px; margin-top: 15px; }.note span { font-size: 10px; color: #6a8172; }.note p { font-size: 10px; line-height: 1.9; color: #94a092; margin: 7px 0 0; }.footer { display: flex; justify-content: space-between; gap: 12px; max-width: 1600px; padding: 2px 38px 19px; margin: auto; color: #94a091; font: 9px monospace; letter-spacing: 1px; }
+.loading { position: absolute; inset: 0; display: flex; gap: 15px; align-items: center; justify-content: center; color: #365745; background: #e5e6de; }.page button:focus-visible, .page a:focus-visible, .page input:focus-visible { outline: 3px solid #5d977b; outline-offset: 3px; }
+@media(max-width: 960px) { .header { padding: 0 22px; height: 74px; }.layout { grid-template-columns: 1fr; gap: 24px; padding: 18px; }.stage { min-height: 480px; height: 64dvh; max-height: 680px; }.panel { max-width: 600px; width: 100%; justify-self: center; padding: 6px 12px 18px; }.intro h1 { font-size: 27px; }.description br { display: none; }.tags { margin-bottom: 22px; }.footer { padding: 0 25px 20px; flex-wrap: wrap; }.headerNote { font-size: 8px; letter-spacing: 1px; }.stageBottom { left: 18px; right: 18px; font-size: 8px; }.stageLabel { left: 20px; font-size: 8px; }.watermark { font-size: 28vw; }.viewControls { bottom: 56px; }.viewControls button { padding: 9px 15px; } }
