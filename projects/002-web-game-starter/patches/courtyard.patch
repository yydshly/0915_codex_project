+import { describe, expect, it } from 'vitest'
+import { Euler, Vector3 } from 'three'
+import { danceDuration, dancePose, solveLeg, type Dance } from './choreography'
+
+describe('Mika choreography', () => {
+  it.each<Dance>(['groove', 'wave', 'idle'])('%s closes its loop without a pose jump', dance => {
+    const start = dancePose(0, dance)
+    expect(dancePose(danceDuration, dance)).toEqual(start)
+    const before = Object.values(dancePose(danceDuration - 0.00001, dance)).flat()
+    const after = Object.values(dancePose(0.00001, dance)).flat()
+    expect(Math.max(...before.map((value, index) => Math.abs(value - after[index])))).toBeLessThan(0.001)
+  })
+
+  it('keeps both ankles on their floor targets across the complete dance', () => {
+    for (let frame = 0; frame <= 240; frame++) {
+      const pose = dancePose(frame / 240 * danceDuration, 'groove')
+      for (const [side, foot] of [[1, pose.leftFoot], [-1, pose.rightFoot]] as const) {
+        const hip: [number, number, number] = [pose.hips[0] + side * 0.17, pose.hips[1], pose.hips[2]]
+        const leg = solveLeg(hip, foot)
+        const thighRotation = new Euler(leg.x, 0, leg.z, 'ZXY')
+        const upper = new Vector3(0, -0.50, 0).applyEuler(thighRotation)
+        const lower = new Vector3(0, -0.46, 0).applyEuler(new Euler(leg.knee, 0, 0)).applyEuler(thighRotation)
+        const actual = new Vector3(...hip).add(upper).add(lower)
+        expect(actual.distanceTo(new Vector3(...foot))).toBeLessThan(0.002)
+        expect(leg.knee).toBeGreaterThan(0)
+        expect(leg.knee).toBeLessThan(Math.PI / 2)
+      }
+    }
+  })
+})
diff --git a/src/features/dancer/systems/choreography.ts b/src/features/dancer/systems/choreography.ts
