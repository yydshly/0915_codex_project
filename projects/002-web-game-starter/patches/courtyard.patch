+  { id: 'energy', number: '02', title: '光伏廊架', subtitle: '开启照明 · 切换夜景', description: '廊架为庭院提供遮荫和照明。切换到夜间并打开庭院灯，观察同一空间在不同光照下的变化。', capability: '实时灯光 / 发光材质 / 阴影', location: [3.1, 0.23, -0.65], marker: [4.6, 4.3, -3.7] },
+  { id: 'physics', number: '03', title: '设备试验台', subtitle: '释放测试箱 · 观察碰撞', description: '将测试箱从吊架下释放，观察重力、翻转、碰撞与反弹。该体验用于展示物理交互。', capability: 'Rapier 刚体 / 重力 / 碰撞事件', location: [5.8, 0.23, 1.4], marker: [5.8, 4, 4.3] },
+]
+
+export type InspectionState = {
+  selected: StationId; arrived: StationId | null; moving: boolean; trip: number;
+  water: boolean; lights: boolean; night: boolean; checked: Record<StationId, boolean>;
+  drop: number; falling: boolean; celebrating: boolean; generation: number; camera: number;
+}
+export const initialInspection: InspectionState = {
+  selected: 'water', arrived: null, moving: false, trip: 0, water: false, lights: false, night: false,
+  checked: { water: false, energy: false, physics: false }, drop: 0, falling: false,
+  celebrating: false, generation: 0, camera: 0,
+}
+export type InspectionAction =
+  | { type: 'select'; id: StationId }
+  | { type: 'arrive'; trip: number }
+  | { type: 'land'; drop: number; generation: number }
+  | { type: 'operate' | 'night' | 'reset' | 'camera' | 'celebrate' }
+
+export function inspectionReducer(state: InspectionState, action: InspectionAction): InspectionState {
+  switch (action.type) {
+    case 'select':
+      if (state.selected === action.id && (state.moving || state.arrived === action.id)) return state
+      return { ...state, selected: action.id, moving: true, arrived: null, trip: state.trip + 1, celebrating: false }
+    case 'arrive':
+      return state.moving && action.trip === state.trip ? { ...state, arrived: state.selected, moving: false } : state
+    case 'operate': {
+      if (state.moving || state.arrived !== state.selected) return state
+      if (state.selected === 'water') return { ...state, water: !state.water, checked: { ...state.checked, water: true } }
+      if (state.selected === 'energy') return { ...state, lights: !state.lights, night: state.lights ? state.night : true, checked: { ...state.checked, energy: true } }
+      return state.falling ? state : { ...state, drop: state.drop + 1, falling: true }
+    }
+    case 'land':
+      return state.falling && action.drop === state.drop && action.generation === state.generation
+        ? { ...state, falling: false, checked: { ...state.checked, physics: true } } : state
+    case 'night': return { ...state, night: !state.night }
+    case 'camera': return { ...state, camera: state.camera + 1 }
+    case 'celebrate': return Object.values(state.checked).every(Boolean) && !state.moving ? { ...state, celebrating: !state.celebrating } : state
+    case 'reset': return { ...initialInspection, generation: state.generation + 1, camera: state.camera + 1, trip: state.trip + 1 }
+  }
+}
+
+export function inspectionPath(from: Point, destination: Point): Point[] {
+  return [[from[0], 0.23, 1.4], [destination[0], 0.23, 1.4], [...destination]]
+}
