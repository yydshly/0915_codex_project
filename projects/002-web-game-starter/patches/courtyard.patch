+import { describe, expect, it } from 'vitest'
+import { initialInspection, inspectionPath, inspectionReducer } from './inspection'
+
+describe('inspection state boundaries', () => {
+  it('requires arrival and ignores stale arrival events after a destination change', () => {
+    expect(inspectionReducer(initialInspection, { type: 'operate' })).toBe(initialInspection)
+    const waterTrip = inspectionReducer(initialInspection, { type: 'select', id: 'water' })
+    const energyTrip = inspectionReducer(waterTrip, { type: 'select', id: 'energy' })
+    expect(inspectionReducer(energyTrip, { type: 'arrive', trip: waterTrip.trip }).moving).toBe(true)
+    const arrived = inspectionReducer(energyTrip, { type: 'arrive', trip: energyTrip.trip })
+    expect(inspectionReducer(arrived, { type: 'operate' })).toMatchObject({ lights: true, night: true, checked: { energy: true } })
+  })
+  it('records physical contact rather than marking a release as complete', () => {
+    let state = inspectionReducer(initialInspection, { type: 'select', id: 'physics' })
+    state = inspectionReducer(state, { type: 'arrive', trip: state.trip })
+    state = inspectionReducer(state, { type: 'operate' })
+    expect(state.checked.physics).toBe(false)
+    expect(inspectionReducer(state, { type: 'operate' })).toBe(state)
+    const landed = inspectionReducer(state, { type: 'land', drop: state.drop, generation: state.generation })
+    expect(landed.checked.physics).toBe(true)
+    const reset = inspectionReducer(state, { type: 'reset' })
+    expect(inspectionReducer(reset, { type: 'land', drop: state.drop, generation: state.generation })).toBe(reset)
+  })
+  it('retains completed checks after switching a facility off and resets explicitly', () => {
+    let state = inspectionReducer(initialInspection, { type: 'select', id: 'water' })
+    state = inspectionReducer(state, { type: 'arrive', trip: state.trip })
+    state = inspectionReducer(inspectionReducer(state, { type: 'operate' }), { type: 'operate' })
+    expect(state).toMatchObject({ water: false, checked: { water: true } })
+    expect(inspectionReducer(state, { type: 'reset' }).checked).toEqual(initialInspection.checked)
+    expect(inspectionPath([-3, 0.23, 1.4], [3.1, 0.23, -0.65])).toEqual([[-3, 0.23, 1.4], [3.1, 0.23, 1.4], [3.1, 0.23, -0.65]])
+  })
+})
