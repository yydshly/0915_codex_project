@@ -0,0 +1,32 @@
+import { useReducer } from 'react'
+import type { MusicTransport, MusicState } from '../components/MusicTransport'
+import { formatMusicTime } from '../systems/musicTiming'
+import styles from './MusicPanel.module.css'
+
+const defaultPrompt = '轻快的 funk-pop 纯音乐，108 BPM，4/4 拍。清晰有力的底鼓和军鼓、弹性贝斯、切分节奏吉他、明亮而克制的合成器。适合俏皮卡通女孩跳街舞。开头尽快进入稳定节拍，每 8 拍形成一个短句，避免长前奏、变速和突然停顿。约 45 秒，无人声，无歌词。'
+
+export function MusicPanel({ transport, state, onImport, onToggle }: { transport: MusicTransport; state: MusicState; onImport: () => void; onToggle: () => void }) {
+  const [prompt, editPrompt] = useReducer((_: string, value: string) => value, defaultPrompt)
+  const [copyStatus, setCopyStatus] = useReducer((_: string, value: string) => value, '')
+  async function copyPrompt() {
+    try { await navigator.clipboard.writeText(prompt); setCopyStatus('描述已复制，粘贴到 MiniMax 的音乐描述中。') }
+    catch { setCopyStatus('未能复制，请选中上方描述手动复制。') }
+  }
+  return <section className={styles.panel} aria-label="音乐创作与同步">
+    <div className={styles.heading}><h2>给舞蹈配一首歌</h2><span>MINIMAX MUSIC</span></div>
+    <label className={styles.label}>音乐创作描述<textarea aria-label="音乐创作描述" value={prompt} maxLength={2000} onChange={event => { editPrompt(event.target.value); setCopyStatus('') }} /></label>
+    <div className={styles.actions}><button onClick={() => { void copyPrompt() }}>复制描述</button><a href="https://www.minimax.cn/audio/music" target="_blank" rel="noopener noreferrer">去 MiniMax 创作 ↗</a></div>
+    {copyStatus ? <p className={styles.hint} role="status">{copyStatus}</p> : null}
+    <p className={styles.hint}>在 MiniMax 网页生成并下载音乐，再导入这里。导入文件只在本机播放。</p>
+    <label className={styles.import}>＋ {state.name ? '更换音乐' : '导入生成的音乐'}<input aria-label="导入音乐文件" type="file" accept=".mp3,.wav,.ogg,.m4a,.aac,.flac,audio/*" onChange={event => { const file = event.target.files?.[0]; if (file && transport.load(file)) onImport(); event.target.value = '' }} /></label>
+    {state.name ? <div className={styles.track}>
+      <div className={styles.trackName}><strong title={state.name}>{state.name}</strong><button onClick={() => { transport.clear(); onImport() }}>卸载</button></div>
+      <div className={styles.actions}><button disabled={state.loading || !state.duration} onClick={onToggle}>{state.loading ? '正在读取音频…' : state.playing ? '暂停音乐与舞蹈' : '播放音乐与舞蹈'}</button><button disabled={!state.duration} onClick={() => transport.seek(0)}>回到开头</button></div>
+      <label className={styles.label}>音乐进度 <span>{formatMusicTime(state.time)} / {formatMusicTime(state.duration)}</span><input aria-label="音乐进度" type="range" min="0" max={state.duration || 1} step="0.05" value={state.time} disabled={!state.duration} onChange={event => transport.seek(Number(event.target.value))} /></label>
+      <div className={styles.fields}><label>音乐 BPM<input aria-label="音乐 BPM" type="number" min="40" max="220" value={state.bpm} onChange={event => transport.configure({ bpm: event.target.valueAsNumber })} /></label><label>第一拍 / 秒<input aria-label="第一拍位置" type="number" min="0" max={state.duration || 0} step="0.05" value={state.offset} onChange={event => transport.configure({ offset: event.target.valueAsNumber })} /></label></div>
+      <p className={styles.hint}>生成音乐的实际节拍可能有偏差；调整 BPM 和第一拍位置来对齐舞蹈。这里尚未自动检测节拍。</p>
+      <label className={styles.label}>音乐音量 <span>{Math.round(state.volume * 100)}%</span><input aria-label="音乐音量" type="range" min="0" max="1" step="0.05" value={state.volume} onChange={event => transport.configure({ volume: Number(event.target.value) })} /></label>
+    </div> : null}
+    {state.error ? <p className={styles.error} role="alert">{state.error}</p> : null}
+  </section>
+}
