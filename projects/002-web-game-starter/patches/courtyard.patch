@@ -0,0 +1,12 @@
+export type MusicSample = { time: number; bpm: number; offset: number }
+export type MusicClock = { read: () => MusicSample | null }
+
+export function musicPoseTime({ time, bpm, offset }: MusicSample) {
+  if (![time, bpm, offset].every(Number.isFinite) || bpm <= 0) return { time: 0, started: false }
+  return { time: Math.max(0, time - offset) * bpm / 108, started: time >= offset }
+}
+
+export function formatMusicTime(seconds: number) {
+  const value = Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0
+  return `${Math.floor(value / 60)}:${String(value % 60).padStart(2, '0')}`
+}
