+import { describe, expect, it } from 'vitest'
+import { formatMusicTime, musicPoseTime } from './musicTiming'
+
+describe('music-driven dance clock', () => {
+  it('waits for the first beat, then maps eight beats to one dance phrase', () => {
+    expect(musicPoseTime({ time: 1, bpm: 120, offset: 2 })).toEqual({ time: 0, started: false })
+    expect(musicPoseTime({ time: 2, bpm: 120, offset: 2 })).toEqual({ time: 0, started: true })
+    expect(musicPoseTime({ time: 6, bpm: 120, offset: 2 }).time).toBeCloseTo(8 * 60 / 108)
+  })
+  it('maps seeks directly without accumulating frame deltas', () => {
+    const sample = { time: 20, bpm: 90, offset: 0.5 }
+    const before = musicPoseTime(sample)
+    musicPoseTime({ ...sample, time: 100 })
+    expect(musicPoseTime(sample)).toEqual(before)
+    expect(musicPoseTime({ ...sample, time: 0 }).started).toBe(false)
+  })
+  it('handles invalid metadata and unready duration labels', () => {
+    expect(musicPoseTime({ time: NaN, bpm: 108, offset: 0 }).started).toBe(false)
+    expect(musicPoseTime({ time: 10, bpm: 0, offset: 0 }).started).toBe(false)
+    expect(formatMusicTime(Infinity)).toBe('0:00')
+    expect(formatMusicTime(125.9)).toBe('2:05')
+  })
+})
