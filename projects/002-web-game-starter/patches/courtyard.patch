@@ -0,0 +1,51 @@
+import { useEffect, useMemo, useRef } from 'react'
+import { useFrame } from '@react-three/fiber'
+import { Euler, Quaternion, Vector3 } from 'three'
+import { createMikaRig, joint } from './mikaSkeleton'
+import { dancePose, solveLeg, type Dance } from '../systems/choreography'
+import { musicPoseTime, type MusicClock } from '../systems/musicTiming'
+
+export function Mika({ dance = 'groove', playing = true, speed = 1, sampleTime, musicClock }: { dance?: Dance; playing?: boolean; speed?: number; sampleTime?: number; musicClock?: MusicClock }) {
+  const rig = useMemo(() => createMikaRig(), [])
+  const time = useRef(0)
+  const orientation = useMemo(() => new Quaternion(), [])
+  const euler = useMemo(() => new Euler(), [])
+  const target = useMemo(() => new Vector3(), [])
+  const first = useRef(true)
+  const previousDance = useRef(dance)
+  useEffect(() => () => { rig.skeleton.dispose() }, [rig])
+  useFrame((_, delta) => {
+    const music = musicClock?.read()
+    const synced = music ? musicPoseTime(music) : null
+    if (!synced && !playing && !first.current && sampleTime === undefined && previousDance.current === dance) return
+    previousDance.current = dance
+    const elapsed = Math.min(delta, 0.05)
+    if (!synced && playing && sampleTime === undefined) time.current += elapsed * speed
+    const pose = dancePose(sampleTime ?? synced?.time ?? time.current, synced && !synced.started ? 'idle' : dance)
+    const blend = first.current || sampleTime !== undefined || synced ? 1 : 1 - Math.exp(-elapsed * 13)
+    first.current = false
+    const bones = rig.bones
+    const rotate = (id: number, x: number, y: number, z: number, order: 'XYZ' | 'ZXY' = 'XYZ') => {
+      orientation.setFromEuler(euler.set(x, y, z, order))
+      bones[id].quaternion.slerp(orientation, blend)
+    }
+    bones[0].position.lerp(target.set(...pose.hips), blend)
+    rotate(joint.chest, ...pose.chest)
+    rotate(joint.head, ...pose.head)
+    rotate(joint.leftArm, ...pose.left)
+    rotate(joint.rightArm, ...pose.right)
+    rotate(joint.leftForearm, pose.leftElbow, 0, 0)
+    rotate(joint.rightForearm, pose.rightElbow, 0, 0)
+    rotate(joint.leftHand, 0, 0, pose.wrist)
+    rotate(joint.rightHand, 0, 0, -pose.wrist)
+    for (const [thigh, sign, foot] of [[joint.leftThigh, 1, pose.leftFoot], [joint.rightThigh, -1, pose.rightFoot]] as const) {
+      const hip = bones[0].position
+      const leg = solveLeg([hip.x + sign * 0.17, hip.y, hip.z], foot)
+      rotate(thigh, leg.x, 0, leg.z, 'ZXY')
+      rotate(thigh + 1, leg.knee, 0, 0)
+      orientation.copy(bones[thigh].quaternion).multiply(bones[thigh + 1].quaternion).invert()
+      bones[thigh + 2].quaternion.copy(orientation)
+    }
+  })
+  return <primitive object={rig.root} dispose={null} />
+}
