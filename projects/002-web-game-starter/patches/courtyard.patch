+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { MusicTransport } from './MusicTransport'
+
+class AudioMock {
+  static instances: AudioMock[] = []
+  duration = 40
+  currentTime = 0
+  playbackRate = 1
+  volume = 1
+  ended = false
+  preload = ''
+  onloadedmetadata: (() => void) | null = null
+  ontimeupdate: (() => void) | null = null
+  onplay: (() => void) | null = null
+  onpause: (() => void) | null = null
+  onended: (() => void) | null = null
+  onerror: (() => void) | null = null
+  constructor() { AudioMock.instances.push(this) }
+  play = vi.fn(async () => { this.onplay?.() })
+  pause = vi.fn(() => { this.onpause?.() })
+  removeAttribute = vi.fn()
+  load = vi.fn()
+}
+const file = (name = 'test.mp3') => new File(['audio-fixture'], name)
+describe('music transport', () => {
+  beforeEach(() => {
+    AudioMock.instances = []
+    vi.stubGlobal('Audio', AudioMock)
+    vi.spyOn(URL, 'createObjectURL').mockReturnValue('blob:fixture')
+    vi.spyOn(URL, 'revokeObjectURL').mockImplementation(() => {})
+  })
+  afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals() })
+  it('uses audio time for pause, seek, speed and replay', async () => {
+    const player = new MusicTransport()
+    player.load(file())
+    const audio = AudioMock.instances[0]
+    audio.onloadedmetadata!()
+    await player.play()
+    expect(player.state.playing).toBe(true)
+    player.seek(15)
+    player.setSpeed(1.5)
+    expect(audio.playbackRate).toBe(1.5)
+    expect(player.read()?.time).toBe(15)
+    player.pause()
+    expect(player.state.playing).toBe(false)
+    player.seek(100)
+    expect(player.read()?.time).toBe(40)
+    audio.ended = true
+    audio.onended!()
+    await player.play()
+    expect(player.read()?.time).toBe(0)
+    player.dispose()
+  })
+  it('releases old media, ignores stale metadata and rejects invalid replacements', () => {
+    const player = new MusicTransport()
+    player.load(file())
+    const old = AudioMock.instances[0]
+    const staleMetadata = old.onloadedmetadata!
+    player.load(file('new.wav'))
+    staleMetadata()
+    expect(player.state.duration).toBe(0)
+    expect(old.pause).toHaveBeenCalled()
+    expect(URL.revokeObjectURL).toHaveBeenCalledWith('blob:fixture')
+    AudioMock.instances[1].onloadedmetadata!()
+    expect(player.load(file('bad.txt'))).toBe(false)
+    expect(player.state.name).toBe('new.wav')
+    expect(player.read()).not.toBeNull()
+    player.clear()
+    expect(player.read()).toBeNull()
+    expect(player.state.name).toBe('')
+  })
+  it('reports blocked playback without claiming to play', async () => {
+    const player = new MusicTransport()
+    player.load(file())
+    const audio = AudioMock.instances[0]
+    audio.onloadedmetadata!()
+    audio.play.mockRejectedValueOnce(new Error('NotAllowedError'))
+    expect(await player.play()).toBe(false)
+    expect(player.state.playing).toBe(false)
+    expect(player.state.error).not.toBe('')
+    player.dispose()
+  })
+})
