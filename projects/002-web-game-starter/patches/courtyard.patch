index 0000000..ff93286
--- /dev/null
+++ b/src/features/dancer/systems/choreography.ts
@@ -0,0 +1,61 @@
+export type Dance = 'groove' | 'wave' | 'idle'
+export type CameraView = 'front' | 'side' | 'back' | 'detail'
+export type DanceControls = { dance: Dance; playing: boolean; speed: number; view: CameraView; revision: number }
+export const defaultControls: DanceControls = { dance: 'groove', playing: true, speed: 1, view: 'front', revision: 0 }
+export const danceDuration = 8 * 60 / 108
+type Rotation = [number, number, number]
+type Arms = { left: Rotation; right: Rotation; leftElbow: number; rightElbow: number }
+
+const grooveKeys: Arms[] = [
+  { left: [-0.4, -0.12, 0.65], right: [-0.7, 0.1, -0.40], leftElbow: -1.05, rightElbow: -1.55 },
+  { left: [-0.75, -0.25, 0.34], right: [-0.25, 0.12, -0.70], leftElbow: -1.6, rightElbow: -0.9 },
+  { left: [-0.8, -0.15, 1.5], right: [-0.35, 0.15, -0.7], leftElbow: -0.35, rightElbow: -1.3 },
+  { left: [-0.4, -0.2, 0.8], right: [-0.7, 0.15, -1.5], leftElbow: -1.3, rightElbow: -0.35 },
+  { left: [-1.0, -0.1, 0.32], right: [-1.0, 0.1, -0.32], leftElbow: -1.0, rightElbow: -1.0 },
+  { left: [-0.3, -0.1, 1.25], right: [-0.3, 0.1, -1.25], leftElbow: -0.45, rightElbow: -0.45 },
+  { left: [-0.5, -0.1, 2.18], right: [-0.5, 0.1, -1.1], leftElbow: -0.5, rightElbow: -1.0 },
+  { left: [-0.5, -0.1, 1.1], right: [-0.5, 0.1, -2.18], leftElbow: -1.0, rightElbow: -0.5 },
+]
+const waveKeys: Arms[] = [
+  { left: [0, 0, 1.35], right: [0, 0, -0.65], leftElbow: -0.2, rightElbow: -1.3 },
+  { left: [-0.1, 0, 1.9], right: [-0.2, 0, -1.1], leftElbow: -0.85, rightElbow: -0.6 },
+  { left: [0, 0, 1.25], right: [0, 0, -1.75], leftElbow: -1.3, rightElbow: -0.2 },
+  { left: [-0.2, 0, 0.7], right: [-0.1, 0, -2.0], leftElbow: -0.6, rightElbow: -0.85 },
+]
+
+const smooth = (x: number) => x * x * (3 - 2 * x)
+const lerp = (a: number, b: number, t: number) => a + (b - a) * t
+function rotation(a: Rotation, b: Rotation, t: number): Rotation {
+  return [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)]
+}
+
+export function dancePose(seconds: number, dance: Dance) {
+  const beat = ((seconds % danceDuration) + danceDuration) % danceDuration / danceDuration * 8
+  const angle = beat * Math.PI
+  const sway = Math.sin(angle / 2)
+  const keys = dance === 'wave' ? waveKeys : grooveKeys
+  const position = beat / 8 * keys.length
+  const index = Math.floor(position), mix = smooth(position - index)
+  const from = keys[index % keys.length], to = keys[(index + 1) % keys.length]
+  const idle = dance === 'idle'
+  return {
+    hips: [idle ? 0 : 0.085 * sway, idle ? 1.08 + 0.005 * Math.sin(angle / 2) : 1.026 - 0.036 * Math.cos(angle * 2), idle ? 0 : 0.018 * Math.sin(angle)] as Rotation,
+    chest: [idle ? 0 : 0.05 * Math.cos(angle * 2), idle ? 0 : 0.12 * Math.sin(angle / 2 - 0.25), idle ? 0 : -0.075 * sway] as Rotation,
+    head: [0.035 * Math.sin(angle / 2), idle ? 0 : -0.10 * Math.sin(angle / 2 - 0.5), idle ? 0 : 0.06 * sway] as Rotation,
+    left: idle ? [0, 0, 0.12] as Rotation : rotation(from.left, to.left, mix),
+    right: idle ? [0, 0, -0.12] as Rotation : rotation(from.right, to.right, mix),
+    leftElbow: idle ? -0.10 : lerp(from.leftElbow, to.leftElbow, mix),
+    rightElbow: idle ? -0.10 : lerp(from.rightElbow, to.rightElbow, mix),
+    wrist: idle ? 0 : 0.16 * Math.sin(angle / 2),
+    leftFoot: [0.225, 0.14, idle ? 0 : 0.025 * (1 - Math.cos(angle / 2))] as Rotation,
+    rightFoot: [-0.225, 0.14, idle ? 0 : 0.025 * (1 + Math.cos(angle / 2))] as Rotation,
+  }
+}
+
+export function solveLeg(hip: Rotation, foot: Rotation) {
+  const dx = foot[0] - hip[0], dy = foot[1] - hip[1], dz = foot[2] - hip[2]
+  const distance = Math.min(0.959, Math.max(0.041, Math.hypot(dx, dy, dz)))
+  const alpha = Math.acos(Math.max(-1, Math.min(1, (0.5 ** 2 + distance ** 2 - 0.46 ** 2) / (distance))))
+  const knee = Math.PI - Math.acos(Math.max(-1, Math.min(1, (0.5 ** 2 + 0.46 ** 2 - distance ** 2) / (2 * 0.5 * 0.46))))
+  return { x: -Math.atan2(dz, Math.hypot(dx, dy)) - alpha, z: Math.atan2(dx, -dy), knee }
+}
